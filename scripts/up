#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
n=${MEMBERS:-5}
[[ $n =~ ^[3-5]$ ]] || { echo "MEMBERS must be 3 to 5, got $n" >&2; exit 2; }
members=()
for i in $(seq 1 "$n"); do members+=("member$i"); done
docker compose up -d bitcoind relay router "${members[@]}"
MEMBERS=$n docker compose up --build --no-deps --exit-code-from seed seed
